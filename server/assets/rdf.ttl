# --- Tools ---

<https://kurrawong.ai/products/#kgm>
    a schema:SoftwareApplication ;
    schema:additionalType "Tool" ;
    schema:applicationCategory "Knowledge Graph management tool" ;
    schema:description "KGM is a Python command line and workflow application, developed by KurrawongAI, that helps manage parts of Knowledge Graphs."@en ;
    schema:isPartOf <https://kurrawong.ai/#docs-website> ;
    schema:name "KGM"@en ;
    schema:provider <https://kurrawong.ai> ;
    schema:url "https://docs.kurrawong.ai/products/tools/kgm/"^^xsd:anyURI ;
.

<https://kurrawong.ai/products/#pylode>
    a schema:SoftwareApplication ;
    schema:additionalType "Tool" ;
    schema:applicationCategory "Ontology documentation tool" ;
    schema:description "pyLODE is an online tool used to generate human-readable HTML documentation from ontologies."@en ;
    schema:isPartOf <https://kurrawong.ai/#tools-website> ;
